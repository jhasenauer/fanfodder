// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  // Relations
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  folders       Folder[]
  tags          Tag[]
  createdAt     DateTime       @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Feed {
  id           String         @id @default(cuid())
  url          String         @unique
  title        String?
  description  String?
  link         String?
  icon         String?
  lastFetched  DateTime?
  items        FeedItem[]
  createdAt    DateTime       @default(now())
  Subscription Subscription[]
}

model FeedItem {
  id             String         @id @default(cuid())
  feedId         String
  guid           String // unique identifier from the feed (not globally unique unless we enforce)
  title          String?
  link           String?
  content        String?
  contentSnippet String?
  isoDate        DateTime?
  publishedAt    DateTime?
  author         String?
  // item interactions
  subscriptions  Subscription[] // Many users may have this item in their feed
  createdAt      DateTime       @default(now())

  feed         Feed           @relation(fields: [feedId], references: [id], onDelete: Cascade)
  UserFeedItem UserFeedItem[]

  @@unique([feedId, guid])
  @@index([feedId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  feedId    String
  folderId  String? // optional folder
  unread    Int      @default(0)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed   Feed    @relation(fields: [feedId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  items      UserFeedItem[]
  FeedItem   FeedItem?      @relation(fields: [feedItemId], references: [id])
  feedItemId String?

  @@unique([userId, feedId])
}

model UserFeedItem {
  id             String   @id @default(cuid())
  subscriptionId String
  feedItemId     String
  isRead         Boolean  @default(false)
  isStarred      Boolean  @default(false)
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  feedItem     FeedItem     @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, feedItemId])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
